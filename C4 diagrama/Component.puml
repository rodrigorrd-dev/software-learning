@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

' Sistema principal
System_Boundary(sys, "SoftwareLearning") {

    ' Container Spring Boot: API de gerenciamento
    Container(springApi, "SoftwareLearning API", "Java Spring Boot", "Gerencia usuários, cursos, atividades e arquivos.") {

        Component(authCtrl, "AuthController", "Controller", "Login, tokens e gerenciamento de sessão do usuário.")
        Component(userCtrl, "UserController", "Controller", "Consulta dados do aluno/orientador.")
        Component(courseCtrl, "CourseController", "Controller", "Cadastro e gerenciamento de cursos e permissões.")
        Component(activityCtrl, "ActivityController", "Controller", "Criação de atividades, associação e listagem.")
        Component(answerCtrl, "AnswerController", "Controller", "Recebe respostas e aciona IA.")
        Component(chatCtrl, "ChatController", "Controller", "Integra com módulo de chat em tempo real.")

        Component(activityService, "ActivityService", "Service", "Regras de negócio das atividades.")
        Component(answerService, "AnswerService", "Service", "Gerencia respostas e histórico.")
        Component(repoLayer, "Repositories", "Repository", "Camada de persistência (ORM/SQL).")
    }

    ' Container FastAPI: microserviço corujao
    Container(fastApi, "Corujao Service", "Python FastAPI", "Processamento de OCR e avaliação automática.") {
        Component(aiService, "AIService", "Service", "Envia OCR e dados para o módulo de IA, recebe feedback.")
        Component(ocrService, "OCRService", "Service", "Processamento de imagens com OpenCV / OCR.space.")
    }

    ' Containers externos
    ContainerDb(postgres, "PostgreSQL", "Relational DB", "Armazena dados acadêmicos de forma segura e estruturada.")
    ContainerDb(firebase, "Firebase Realtime DB", "NoSQL DB", "Sincroniza dados em tempo real entre módulos.")
}

' Relações internas Spring Boot
Rel(authCtrl, repoLayer, "Consulta usuário")
Rel(activityCtrl, activityService, "Delegação")
Rel(answerCtrl, answerService, "Delegação")
Rel(answerCtrl, fastApi, "Solicita correção automática")
Rel(fastApi, repoLayer, "Salva feedback")

' Relações externas
Rel(springApi, postgres, "Lê/Grava dados")
Rel(springApi, firebase, "Sincroniza dados em tempo real")
Rel(fastApi, firebase, "Consulta ou atualiza status/feedbacks")
@enduml